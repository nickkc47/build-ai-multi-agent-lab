---
import { loadProfile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
}
const profile = loadProfile();
const { title = profile.name, description = profile.headline } = Astro.props;
const path = Astro.url.pathname;
// D4: nav is plain Thai, contact sits last and stands out. Guestbook stays linked
// but closed until moderation exists (D5 amendment). Meta page added by owner request (D10);
// hero guide pages highlight "ความสนใจ".
const links = [
  { href: '/', label: 'หน้าแรก', active: path === '/' },
  { href: '/about', label: 'เกี่ยวกับ', active: path.startsWith('/about') },
  { href: '/interests', label: 'ความสนใจ', active: path.startsWith('/interests') || path.startsWith('/heroes') },
  { href: '/meta', label: 'เมตา', active: path.startsWith('/meta') },
  { href: '/guestbook', label: 'สมุดเยี่ยม', active: path.startsWith('/guestbook') },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0a0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      /* Tone (docs/PROFILE.md): black base, burgundy accent — dark, sharp, mysterious.
         All text pairs checked for WCAG AA; burgundy is fill/border only. */
      :root {
        --color-bg: #0e0a0c;
        --color-surface: #1a1216;
        --color-border: #3a2229;
        --color-burgundy: #8c1c35;
        --color-burgundy-deep: #5c1022;
        --color-text: #f3ecee;
        --color-muted: #b8a9af;
        --color-accent: #e0788d;
        --font-body: "Noto Sans Thai", "Leelawadee UI", "Sarabun", system-ui, sans-serif;
        --radius: 4px;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { background: var(--color-bg); }
      body {
        margin: 0;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.7;
        color: var(--color-text);
        background:
          radial-gradient(ellipse at 50% -10%, color-mix(in srgb, var(--color-burgundy-deep) 55%, transparent), transparent 60%),
          var(--color-bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      h1, h2, h3 { line-height: 1.3; font-weight: 700; margin: 0 0 0.5rem; }
      h1 { font-size: clamp(2rem, 6vw, 3.25rem); font-weight: 800; letter-spacing: -0.01em; }
      h2 { font-size: 1.35rem; }
      p, li { color: var(--color-muted); }
      a { color: var(--color-accent); }
      a:hover { color: var(--color-text); }
      :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
      .skip {
        position: absolute; left: -999px; top: 0.5rem;
        background: var(--color-surface); color: var(--color-text); padding: 0.5rem 1rem;
      }
      .skip:focus { left: 0.5rem; }
      .wrap { width: min(880px, 100% - 2rem); margin-inline: auto; }
      header { border-bottom: 1px solid var(--color-border); }
      header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 1rem 0; }
      .brand { color: var(--color-text); font-weight: 800; text-decoration: none; letter-spacing: 0.08em; text-transform: lowercase; }
      nav ul { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.25rem; list-style: none; margin: 0; padding: 0; }
      nav li { color: inherit; }
      nav a { color: var(--color-muted); text-decoration: none; font-weight: 700; font-size: 0.95rem; }
      nav a:hover, nav a[aria-current="page"] { color: var(--color-text); }
      nav a[aria-current="page"] { box-shadow: 0 2px 0 var(--color-burgundy); }
      main { flex: 1; padding: 2.5rem 0 4rem; }
      footer { border-top: 1px solid var(--color-border); padding: 1.25rem 0; font-size: 0.875rem; }
      footer p { margin: 0; }
      .panel {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-burgundy);
        border-radius: var(--radius);
        padding: 1.5rem;
        margin: 1.25rem 0;
      }
      .eyebrow { margin: 0 0 0.25rem; color: var(--color-accent); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.12em; }
      .lead { color: var(--color-text); font-size: 1.2rem; margin: 0 0 0.25rem; }
      .tagline { font-style: italic; margin: 0; }
      .btn {
        display: inline-block; background: var(--color-burgundy); color: #fff; border: 1px solid var(--color-burgundy);
        border-radius: var(--radius); padding: 0.65rem 1.25rem; font: inherit; font-weight: 700;
        text-decoration: none; cursor: pointer;
      }
      .btn:hover { background: var(--color-burgundy-deep); color: #fff; }
      .btn-nav { padding: 0.35rem 0.9rem; color: #fff; }
      .btn-nav[aria-current="page"] { box-shadow: none; background: var(--color-burgundy-deep); }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .tile { display: block; text-decoration: none; margin: 0; }
      .tile h2 { color: var(--color-text); }
      .tile p { margin: 0; }
      .tile:hover { border-left-color: var(--color-accent); }
      label { display: block; margin: 1rem 0 0.35rem; color: var(--color-text); font-weight: 700; }
      .label-en { color: var(--color-muted); font-weight: 400; font-size: 0.875rem; margin-left: 0.35rem; }
      input, textarea {
        font: inherit; width: 100%; color: var(--color-text); background: var(--color-bg);
        border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.65rem 0.8rem;
      }
      input:focus-visible, textarea:focus-visible { border-color: var(--color-accent); }
      ul.plain { padding-left: 1.1rem; }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#content">ข้ามไปเนื้อหา</a>
    <header>
      <div class="wrap">
        <a class="brand" href="/">{profile.name}</a>
        <nav aria-label="หลัก">
          <ul>
            {links.map((l) => (
              <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>
            ))}
            <li>
              <a class="btn btn-nav" href="/contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}>ติดต่อ</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap"><p>{profile.name}{profile.tagline && ` · ${profile.tagline}`}</p></div>
    </footer>
  </body>
</html>
