---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// D7: same fields as POST /api/contact {name, email, message}. The English hint in each
// label keeps the accessible name matching the e2e smoke test (getByLabel('Name')...).
---
<BaseLayout title={`ติดต่อ · ${profile.name}`} description={profile.headline}>
  <p class="eyebrow">ติดต่อ</p>
  <h1>ส่งสัญญาณมา</h1>
  {profile.tagline && <p class="tagline">{profile.tagline}</p>}

  <section class="panel" aria-labelledby="form-title">
    <h2 id="form-title">ฝากข้อความ</h2>
    <p>ชวนปาร์ตี้ ชวนแข่ง หรือเรื่องงาน · ตอบกลับทางอีเมลภายใน 2–3 วัน · ไม่ต้องใส่ข้อมูลส่วนตัวเกินจำเป็น</p>
    <form id="contact-form" novalidate>
      <label for="name">ชื่อ <span class="label-en">(Name)</span></label>
      <input id="name" name="name" required maxlength="80" autocomplete="nickname" aria-describedby="status" />
      <label for="email">อีเมลสำหรับตอบกลับ <span class="label-en">(Email)</span></label>
      <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" aria-describedby="status" />
      <label for="message">ข้อความ <span class="label-en">(Message)</span></label>
      <textarea id="message" name="message" rows="5" required maxlength="2000" aria-describedby="status"></textarea>
      <p class="actions"><button class="btn" type="submit">ส่ง</button></p>
      <p id="status" role="status" aria-live="polite" tabindex="-1"></p>
    </form>
  </section>
</BaseLayout>

<style>
  .actions { margin-top: 1.25rem; }
  button[aria-disabled="true"] { opacity: 0.7; cursor: progress; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('status');
  const button = form?.querySelector('button');
  const fields = form ? Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')) : [];
  const say = (text: string) => { if (status) status.textContent = text; };
  let sending = false;

  // Whitespace-only counts as empty — the server trims too, so catch it here instead of a 400.
  const markInvalid = () => {
    let firstInvalid: HTMLElement | null = null;
    for (const field of fields) {
      field.setCustomValidity(field.value.trim() ? '' : 'required');
      const invalid = !field.checkValidity();
      field.setAttribute('aria-invalid', String(invalid));
      if (invalid && !firstInvalid) firstInvalid = field;
    }
    return firstInvalid;
  };
  for (const field of fields) {
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') markInvalid();
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    const firstInvalid = markInvalid();
    if (firstInvalid) {
      say('กรอกชื่อ อีเมล และข้อความให้ครบ และตรวจรูปแบบอีเมล');
      firstInvalid.focus();
      return;
    }
    const payload = Object.fromEntries(fields.map((f) => [f.name, f.value.trim()]));
    say('กำลังส่ง…');
    // aria-disabled instead of disabled so keyboard focus stays on the button.
    sending = true;
    button?.setAttribute('aria-disabled', 'true');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        say('ได้รับแล้ว จะตอบกลับทางอีเมลที่ให้ไว้');
        form.reset();
        fields.forEach((f) => f.setAttribute('aria-invalid', 'false'));
      } else if (res.status === 400) {
        say('ข้อมูลไม่ครบหรือรูปแบบอีเมลไม่ถูกต้อง ลองตรวจอีกครั้ง');
      } else if (res.status >= 500) {
        // API contract: 201 / 400 / 500 (no 501). Message stays in the form, so resending is one click.
        say('ระบบขัดข้องชั่วคราว ข้อความยังไม่ถูกส่ง ลองใหม่อีกครั้งภายหลัง');
      } else {
        say('ส่งไม่สำเร็จ ลองอีกครั้ง');
      }
    } catch {
      say('ส่งไม่สำเร็จ ตรวจการเชื่อมต่อแล้วลองอีกครั้ง');
    } finally {
      sending = false;
      button?.removeAttribute('aria-disabled');
    }
  });
</script>
