---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// D5 (amended): linked from the nav but closed — no post form and no fetch until the
// guestbook API has validation + moderation. When it opens, render entries with
// textContent / Astro escaping, never innerHTML.
---
<BaseLayout title={`สมุดเยี่ยม · ${profile.name}`} description={profile.headline}>
  <p class="eyebrow">สมุดเยี่ยม</p>
  <h1>ยังไม่เปิด</h1>
  <section class="panel">
    <p>สมุดเยี่ยมยังปิดอยู่ จะเปิดเมื่อระบบคัดกรองข้อความพร้อม</p>
    <p>ระหว่างนี้ ฝากข้อความถึงกันได้ทางหน้าติดต่อ</p>
  </section>
  <ContactCta />
</BaseLayout>
